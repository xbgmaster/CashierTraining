@model IEnumerable<catalog_safeway.Models.Product>

<h2>Product List</h2>

<a asp-controller="Product" asp-action="Create" class="btn btn-safeways mb-3">New</a>
<a asp-controller="ActivityCode" asp-action="ActivityCode" class="btn btn-safeways mb-3">Activity</a>


<table class="table table-bordered" id="productTable">
    <thead>
        <tr>
            <th>Description</th>
            <th>Code</th>
            <th style="width:100px">Image</th>
            <th>Edit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.Code</td>
                <td>
                    @if (item.ImagePath != null)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.ImagePath)" alt="Product Image" style="max-width:100px;" />
                    }
                    else
                    {
                        <span>No image available</span>
                    }
                </td>
                <td>
                    <a asp-controller="Product" asp-action="EditProduct" asp-route-code="@item.Code">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
