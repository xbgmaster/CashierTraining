@model IEnumerable<catalog_safeway.Models.Product>
<div action="form-group" style="text-align:center">
    <h2>Product List SW</h2>
</div>
<div action="form-group">
    <a asp-controller="ActivityCode" asp-action="ActivityCode" class="btn btn-safeways mb-3">Activity</a>
</div>
<table id="productTable" class="table table-bordered table-striped" style="border-collapse:collapse;">
    <thead>
        <tr style="background-color:red; text-align:center">
            <th class="text-center">Description</th>
            <th class="text-center">Code</th>
            <th class="text-center" style="width:100px">Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.Code</td>
                <td>
                    @if (item.ImagePath != null)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.ImagePath)" alt="Product Image" style="max-width:100px;" />
                    }
                    else
                    {
                        <span>No image available</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#productTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                columnDefs: [
                    { orderable: true } // desactiva orden en columnas de imagen y edición
                ]
            });
        });
    </script>
}